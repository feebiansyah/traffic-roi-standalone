{
  "version": 2,
  "functions": {
    "api/relay.mjs": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key":"Referrer-Policy","value":"no-referrer"},
        {"key":"X-Content-Type-Options","value":"nosniff"},
        {"key":"X-Frame-Options","value":"DENY"},
        {"key":"Cache-Control","value":"private, no-store, max-age=0"}
      ]
    }
  ]
}
